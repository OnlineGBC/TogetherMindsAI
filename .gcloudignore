# Files and directories to exclude from gcloud builds submit uploads.
# Keep this in sync with .gitignore for anything large or sensitive.

# Virtual environment — gigabytes, not needed (Docker installs from requirements.txt)
TogetherMindsAI.venv/

# Local database
instance/

# Secrets — never upload. Patterns, not one exact filename: a renamed copy of the
# signing keystore is the same credential, and the build context is uploaded whole.
.env
android.keystore
*.keystore
*.keystore.*
*.jks
*.p12
*.pepk

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Accidental pip shell-redirect artifacts (e.g. a file literally named "=0.41.0")
=*

# Tests — not needed inside the Docker image
tests/

# Claude / editor metadata
.claude/

# Git metadata
.git/
.gitignore

# Android — not needed for Cloud Build
app/
.gradle/
gradle/
gradlew
gradlew.bat
build.gradle
settings.gradle
gradle.properties
*.apk
*.aab
*.idsig
manifest-checksum.txt
store_icon.png
