# ============================================================
# TogetherMindsAI — environment variable reference
# ============================================================
#
# USAGE
#   Local (laptop/Android/iPhone):
#     Copy this file to .env and fill in your values.
#     .env is gitignored and must never be committed.
#
#   Google Cloud Run:
#     Each variable below is stored as an individual secret in
#     GCP Secret Manager under the name shown in [SECRET: ...].
#     Cloud Run mounts them as environment variables at runtime.
#     .env is NOT used on Cloud Run — leave it absent.
#
# RECOVERY
#     All variable names, their descriptions, and their default
#     values (where safe to publish) are documented here.
#     Sensitive values (keys, passwords) must be retrieved from
#     your password manager or GCP Secret Manager console.
#
# ============================================================

# ------------------------------------------------------------
# Flask core
# [SECRET: SECRET_KEY]  — used on BOTH platforms
# ------------------------------------------------------------

# Required. Flask session signing key. Use a long random string.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" only during local development. Always "false" on Cloud Run.
# [LOCAL ONLY — not stored in Secret Manager]
FLASK_DEBUG=false

# ------------------------------------------------------------
# CORS / SocketIO
# [SECRET: CORS_ALLOWED_ORIGINS]  — used on BOTH platforms
# ------------------------------------------------------------

# Comma-separated list of allowed origins for SocketIO CORS.
# Local:      http://localhost:5001
# Cloud Run:  https://YOUR-SERVICE-HASH-uc.a.run.app
CORS_ALLOWED_ORIGINS=http://localhost:5001

# ------------------------------------------------------------
# Database
# [SECRET: DATABASE_URL]  — used on BOTH platforms
# ------------------------------------------------------------

# SQLAlchemy connection string.
#
# Local:     sqlite:///togethermindsai.db   (default, no server needed)
# Cloud Run: postgresql+psycopg2://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# On Cloud Run the Cloud SQL connector uses a Unix socket — the ?host= form
# above is required; replace PROJECT, REGION, INSTANCE, USER, PASSWORD, DBNAME
# with your Cloud SQL values.
DATABASE_URL=sqlite:///togethermindsai.db

# ------------------------------------------------------------
# Rate limiting
# [SECRET: RATE_WINDOW_SECONDS]   — used on BOTH platforms
# [SECRET: RATE_MAX_MESSAGES]     — used on BOTH platforms
# ------------------------------------------------------------

RATE_WINDOW_SECONDS=60
RATE_MAX_MESSAGES=20

# ------------------------------------------------------------
# AI cooldown (couple/group only)
# [SECRET: AI_COOLDOWN_SECONDS]  — used on BOTH platforms
# ------------------------------------------------------------

# Seconds the AI waits before responding again in couple/group mode.
# Lower = more frequent AI responses. Default: 20
AI_COOLDOWN_SECONDS=20

# ------------------------------------------------------------
# Silence nudge (couple/group only)
# [SECRET: SILENCE_NUDGE_SECONDS]  — used on BOTH platforms
# ------------------------------------------------------------

# Seconds of total silence after which the AI sends a brief re-engagement
# nudge in couple/group sessions. Set to 0 to disable. Default: 45
SILENCE_NUDGE_SECONDS=45

# ------------------------------------------------------------
# Input validation
# [SECRET: MAX_MESSAGE_LENGTH]  — used on BOTH platforms
# ------------------------------------------------------------

MAX_MESSAGE_LENGTH=2000

# ------------------------------------------------------------
# AI — Anthropic Claude
# [SECRET: ANTHROPIC_API_KEY]  — used on BOTH platforms
# ------------------------------------------------------------

# Required. Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# GCP — Cloud SQL connection name
# [SECRET: CLOUD_SQL_CONNECTION_NAME]  — CLOUD RUN ONLY
#
# Not needed locally (SQLite is used). Stored in Secret Manager
# so the Dockerfile / cloudbuild.yaml can reference it at deploy time.
# Format: PROJECT_ID:REGION:INSTANCE_NAME
# Example: togethermindsai:us-central1:togethermindsai-db
# [LOCAL: leave blank or omit]
# ------------------------------------------------------------

CLOUD_SQL_CONNECTION_NAME=

# ------------------------------------------------------------
# HuggingFace
# [SECRET: HF_TOKEN]  — used on BOTH platforms
#
# Required for downloading the emotion classifier model.
# Get yours at https://huggingface.co/settings/tokens
# [LOCAL: set in .env]
# ------------------------------------------------------------

HF_TOKEN=

# ------------------------------------------------------------
# Clinician sign-in — Google & Microsoft OAuth (OpenID Connect)
# [SECRET: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET]
# [SECRET: MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET]
#
# Optional: the app runs without these, but the /login buttons only work once
# set. We store NO email/password — providers handle login + 2FA; we keep only
# the provider's opaque account id.
#
# Register an OAuth app with each provider and add these redirect URIs:
#   Google  (console.cloud.google.com → APIs & Services → Credentials):
#       https://localhost:5001/auth/google/callback
#       https://YOUR-DOMAIN/auth/google/callback
#   Microsoft (Azure portal → App registrations; "common" tenant):
#       https://localhost:5001/auth/microsoft/callback
#       https://YOUR-DOMAIN/auth/microsoft/callback
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows any Microsoft work/school or personal account. Default: common
MICROSOFT_TENANT=common
