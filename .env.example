# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# REQUIRED — Flask session signing key. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to "true" only during local development. Always "false" in production.
FLASK_DEBUG=false

# Comma-separated list of allowed origins for SocketIO CORS.
# For local dev: http://localhost:5001
CORS_ALLOWED_ORIGINS=http://localhost:5001

# SQLAlchemy database URI. Defaults to local SQLite file.
DATABASE_URL=sqlite:///togethermindsai.db

# Rate limiting — messages per user per window
RATE_WINDOW_SECONDS=60
RATE_MAX_MESSAGES=20

# Maximum allowed message length in characters
MAX_MESSAGE_LENGTH=2000

# Anthropic API key — required for Claude Sonnet responses
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=
